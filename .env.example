# ── Frontend (Vite) ──────────────────────────────────────────────────────────
# Sent on every API call from the browser — see src/lib/apiSecret.ts for what this does and
# does NOT protect (it's readable in the shipped JS bundle). Same value as API_SECRET below.
VITE_API_SECRET=

# ── Backend (netlify/functions/api.mts, read via `netlify dev` locally) ─────
# Neon Postgres connection string — a DEV branch locally, never the production one.
DATABASE_URL=

# Must match VITE_API_SECRET above. Generate with: openssl rand -hex 32
API_SECRET=

ANTHROPIC_API_KEY=

# Square (optional locally — omitted, /api/square/* fails gracefully and the chat falls back
# to recording "par Square" sales as unpaid instead of creating a real payment link)
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_APP_ID=
SQUARE_ENV=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
